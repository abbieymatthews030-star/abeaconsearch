{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastify",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "functions": {
    "src/index.ts": {
      "includeFiles": "web/dist/**"
    }
  },
  "env": {
    "BEACON_DATA_DIR": "/tmp/beacon-data",
    "BEACON_HOST": "0.0.0.0",
    "BEACON_WEB_DIR": "web/dist"
  }
}
