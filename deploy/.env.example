# Copy this file to the repository root as .env. Keep .env private.
BEACON_DOMAIN=search.example.com
BEACON_USER=search-admin
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'use-a-long-unique-password'
# Paste the resulting bcrypt hash here. Keep the surrounding quotes.
BEACON_PASSWORD_HASH='$2a$14$replace_with_generated_bcrypt_hash'
