# Copy to `beacon.env` and fill in. This file is read by both containers in
# docker-compose.prod.yml. Keep the real `beacon.env` out of git (it is
# already covered by .gitignore) and `chmod 600` it.

# --- Public hostname -------------------------------------------------------
# The domain this instance answers on. DNS A/AAAA records for it must point
# at this server. Use `localhost` for a local trial (Caddy internal CA).
BEACON_DOMAIN=search.example.com

# Email Let's Encrypt uses for expiry notices.
BEACON_ACME_EMAIL=admin@example.com

# --- Write protection (HTTP basic auth on POST/PUT/DELETE/PATCH) ----------
# Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-password'
BEACON_AUTH_USER=admin
BEACON_AUTH_HASH=$2a$14$REPLACE_WITH_GENERATED_HASH

# --- Optional: number plate provider keys --------------------------------
# Offline plate checks work without these. See ../.env.example for details.
DVLA_VES_API_KEY=
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=

# --- Optional: crawler tuning -------------------------------------------
BEACON_CRAWL_MAX_PAGES=100
