# Public website on your own domain (no basic auth).
# Copy to the repository root as `.env`:
#   cp deploy/.env.public.example .env
#
# Then:
#   docker compose -f docker-compose.yml -f docker-compose.public.yml up -d --build

# The hostname people type in the browser (DNS A/AAAA must point here).
BEACON_DOMAIN=search.example.com

# Canonical https origin used in the UI / health payload (usually matches the domain).
BEACON_SITE_URL=https://search.example.com
BEACON_SITE_NAME=Beacon Search

# Optional overrides
# BEACON_RATE_LIMIT_MAX=80
# BEACON_LOOKUPS_ENABLED=true
